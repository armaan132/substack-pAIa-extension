{
  "manifest_version": 3,
  "name": "Daily Briefing pAIa",
  "version": "1.0.0",
  "description": "Re-ranks your Substack feed from your own read/like/hide feedback. All data stays on your device.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.substack.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Daily Briefing pAIa",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.substack.com/*"
      ],
      "js": [
        "engine.js",
        "store.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
